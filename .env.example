# Vercel Postgres (auto-populated when you connect a Postgres store in Vercel dashboard)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# Vercel Blob (auto-populated when you connect a Blob store in Vercel dashboard)
BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# App Authentication
APP_PASSWORD="choose-a-strong-password"
APP_SECRET="generate-with-openssl-rand-hex-16"
